packages:
    packages/agent-process
    packages/agent-cli
    packages/agent-telegram
    packages/agent-core
    packages/agent-mcp
    packages/agent-codex-dialect
    packages/agent-grok-build-dialect
    packages/agent-json
    packages/agent-syntax
    packages/agent-tui
    packages/agent-responses-types
    packages/agent-responses
    packages/agent-provider
    packages/agent-store
    packages/claude-agent-sdk-haskell

tests: True
multi-repl: True

-- Pin the Hasql API set so the resolve plan stays on one major version
-- across developer machines.
constraints:
    hasql == 2.0.1.0,
    hasql-pool == 1.5.0.1,
    hasql-transaction == 1.2.3.1,
    crypton < 1.1
