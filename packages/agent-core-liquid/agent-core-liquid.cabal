cabal-version:      2.2
name:               agent-core-liquid
version:            0.1.0.0
synopsis:           Liquid Haskell verification of pure agent-core modules
description:        Opt-in refinement-type verification for selected pure
                    agent-core modules. The verified sources are shared with
                    agent-core through the @src@ symlink; their @{-@ \@-}@
                    annotations are comments for the normal build. This
                    package is built only through cabal.liquid.project, never
                    by the default project build. See docs/liquid-haskell.md.
license:            MIT
license-file:       LICENSE
author:             digitally induced GmbH
maintainer:         marc@digitallyinduced.com
build-type:         Simple

library
    hs-source-dirs:     src
    exposed-modules:    Agent.TextBuffer
                      , Agent.InterAgentMessage
                      , Agent.OsPath
                      , Agent.Subagents.TaskPath
    build-depends:      base
                      , filepath
                      , liquidhaskell == 0.9.14.1.1
                      , safe-exceptions
                      , text
    -- -O0: with optimisation GHC splits the strict TextBuffer constructor
    -- into worker/wrapper, which liquidhaskell-boot-0.9.14.1.1 cannot merge
    -- (ucsd-progsys/liquidhaskell#2629). Verification does not need
    -- optimised code.
    -- -O0/-fomit-interface-pragmas: liquidhaskell-boot-0.9.14.1.1 cannot
    -- merge worker/wrapper splits of strict constructors, including
    -- UNPACKed ones scraped from base interfaces
    -- (ucsd-progsys/liquidhaskell#2629). --prune-unsorted: fixpoint rejects
    -- constraints with free variables from unrefined parameters.
    ghc-options:        -O0 -fomit-interface-pragmas -fplugin=LiquidHaskell
                        -fplugin-opt=LiquidHaskell:--prune-unsorted
    default-language:   GHC2021
    default-extensions: LambdaCase
                      , OverloadedStrings
                      , OverloadedRecordDot
                      , NoFieldSelectors
                      , DuplicateRecordFields
                      , MultiWayIf
