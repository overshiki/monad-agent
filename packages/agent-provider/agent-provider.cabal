cabal-version:      3.0
name:               agent-provider
version:            0.1.0.0
synopsis:           Provider clients for the agent harness (sublibraries per provider)
description:        One package carrying the agent harness's LLM provider
                    clients as internal sublibraries: OpenAI (incl. the
                    vendored ChatGPT Codex transport), xAI, OpenRouter,
                    Gemini, DeepSeek, Kimi, Kimi Code, and Claude.
                    Module names are unchanged from the former standalone
                    packages (Agent.OpenAI.*, Agent.DeepSeek.*, ...).
license:            MIT
license-file:       LICENSE
author:             digitally induced GmbH
maintainer:         marc@digitallyinduced.com
copyright:          (c) 2026 digitally induced GmbH
category:           Web
build-type:         Simple
-- cabal-version 3.0 (not 2.2 like the former packages): the sublibrary
-- dependency syntax `agent-provider:{name}` used by the test suites, the
-- executable, the benchmark, and external packages requires >= 3.0.
extra-source-files: README.md
                  , CHANGELOG.md
                  , UPSTREAM.md
                  , data/models.json
                  , data/prompt.md

common common-opts
    default-language: Haskell2010
    -- Union of the common-opts blocks of the 8 merged packages: agent-openai
    -- additionally enabled DeriveGeneric, DerivingStrategies,
    -- GeneralizedNewtypeDeriving, DataKinds, FlexibleContexts and
    -- TupleSections; every other package was a subset of that list.
    default-extensions: OverloadedStrings
                      , OverloadedRecordDot
                      , DuplicateRecordFields
                      , NoFieldSelectors
                      , LambdaCase
                      , BlockArguments
                      , DeriveGeneric
                      , RecordWildCards
                      , NamedFieldPuns
                      , NumericUnderscores
                      , TypeApplications
                      , ScopedTypeVariables
                      , DerivingStrategies
                      , GeneralizedNewtypeDeriving
                      , DataKinds
                      , FlexibleContexts
                      , TupleSections
                      , PackageImports
    ghc-options:      -Wall
                      -Werror=incomplete-patterns
                      -Werror=incomplete-uni-patterns
                      -Werror=missing-fields
                      -Wno-unused-do-bind
                      -Wno-name-shadowing
                      -Wno-missing-signatures

