executable openai-login
    import:           common-opts
    -- filepath >= 1.4.3 dropped System.OsPath.unsafeEncodeUtf; the shim
    -- source dir recovers it for app/Login.hs (see shim-ospath/System/OsPath.hs).
    mixins:           filepath (System.OsPath as RawOsPath)
    hs-source-dirs:   app
                    , shim-ospath
    main-is:          Login.hs
    other-modules:    System.OsPath
    build-depends:    base >= 4.14 && < 5
                    , agent-core
                    , agent-provider:{openai}
                    , directory
                    , filepath
                    , text

